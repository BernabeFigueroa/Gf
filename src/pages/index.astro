---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';
import ProjectStrip from '../components/ProjectStrip.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import MobileMenuModal from '../components/MobileMenuModal.astro';
import ContactModal from '../components/ContactModal.astro';
import SplashIntro from '../components/SplashIntro.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout>
  <!-- Splash Screen Intro (Estilo Pacto: fondo marrón y letras rosa) -->
  <SplashIntro />

  <!-- Custom Floating Mouse Follower for Desktop -->
  <div id="custom-cursor" class="custom-cursor">
    <div id="cursor-gf" class="cursor-gf">GF</div>
    <div class="cursor-content">
      <span id="cursor-title" class="cursor-title"></span>
      <span id="cursor-sub" class="cursor-sub"></span>
    </div>
  </div>

  <!-- FIXED TOP HEADER -->
  <Header />

  <!-- MAIN GLOBAL VIEW CONTAINER -->
  <main id="app-container" class="app-viewport">

    <!-- VIEW 1: HOME FULL-BLEED SLIDESHOW -->
    <section id="view-home" class="view-panel active">
      <div id="slideshow-track" class="slideshow-track">
        <!-- Slides dynamically rendered by JS -->
      </div>
    </section>

    <!-- VIEW 2: CATEGORY / GRID VIEW (ARQUITECTURA & INTERIORES, ALL PROJECTS) -->
    <section id="view-grid" class="view-panel">
      <div id="projects-grid" class="editorial-grid">
        <!-- Rendered via JS -->
      </div>
    </section>

    <!-- VIEW 2B: MÁRMOL SHOWCASE (Marmolería Frontini & Arquitectura en Piedra) -->
    <section id="view-marmol" class="view-panel">
      <div class="marmol-viewport">
        <header class="marmol-header">
          <span class="mono-label" data-i18n="marmol_badge">[ MARMOLERÍA FRONTINI — EST. 1949 ]</span>
          <h2 class="marmol-title" data-i18n="marmol_title">STONE AS ARCHITECTURE</h2>
          
          <blockquote class="marmol-quote" data-i18n="marmol_quote">
            “I DON’T JUST SPECIFY STONE. I DESIGN WITH IT”
          </blockquote>

          <p class="marmol-body" data-i18n="marmol_body">
            Stone is incorporated into my projects as architecture, furniture and detail — from monolithic tables and sculptural vanities to kitchens, bars, walls and bespoke elements.
          </p>
        </header>

        <div id="marmol-grid" class="marmol-grid">
          <!-- Rendered via JS dynamically -->
        </div>

        <div class="marmol-footer-block">
          <div class="marmol-heritage-text">
            <span class="marmol-heritage-brand" data-i18n="marmol_heritage_brand">MARMOLERÍA FRONTINI</span>
            <span class="marmol-heritage-sub" data-i18n="marmol_heritage_sub">Stone fabrication & craftsmanship since 1949.</span>
          </div>
          <a 
            href="https://www.instagram.com/marmoleriafrontini/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="marmol-ig-btn"
            data-i18n="marmol_ig_btn"
          >
            @MARMOLERIAFRONTINI ↗
          </a>
        </div>
      </div>
    </section>

    <!-- VIEW 3: PROJECT DETAIL VIEW -->
    <section id="view-project" class="view-panel">
      <!-- Desktop: Horizontal Multi-Image Carousel | Mobile: Stacked Vertical -->
      <div class="project-view-wrapper">
        <div id="project-gallery-track" class="project-gallery-track">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Desktop Metadata Strip -->
      <ProjectStrip />

      <!-- Mobile Floating CTA: DETAILS -->
      <div class="mobile-cta-wrapper">
        <button id="btn-open-drawer" class="mobile-details-btn" data-action="open-drawer">
          <span id="btn-text-lang" data-i18n="details_btn">DETALLES</span>
        </button>
      </div>
    </section>

    <!-- VIEW 4: ABOUT PAGE -->
    <section id="view-about" class="view-panel">
      <div class="about-container">
        <div class="about-image-column">
          <img id="about-portrait-img" src={`${base}/images/arquitecto/giovanni-frontini.webp`} alt="Giovanni Frontini" class="about-portrait" loading="lazy">
          <div class="portrait-caption">
            <div class="portrait-signature-name">GIOVANNI FRONTINI</div>
            <div class="portrait-signature-role">Architect · Interior Designer · Designer</div>
            <div class="portrait-signature-location">Tucumán, Argentina</div>
          </div>
        </div>
        <div class="about-text-column">
          <div class="about-section">
            <h2 class="editorial-heading about-name-title" id="about-manifesto-title">GIOVANNI FRONTINI</h2>
            <div class="about-subtitle" id="about-subtitle">Arquitecto & Diseñador de Interiores</div>
            
            <p class="editorial-body" id="about-bio-p1">
              Soy arquitecto y diseñador de interiores. Me gusta crear espacios con identidad, donde la arquitectura, los materiales, la luz y las texturas tengan un rol protagonista.
            </p>
            <p class="editorial-body" id="about-bio-p2">
              Tengo una especial conexión con la piedra y los materiales naturales, y mi experiencia en arquitectura y fabricación me permite trabajar los proyectos desde una mirada integral, desde la idea inicial hasta el último detalle.
            </p>
            <p class="editorial-body" id="about-bio-p3">
              Busco que cada espacio tenga su propia personalidad, pero que al mismo tiempo se sienta simple, cálido y atemporal.
            </p>

            <blockquote class="about-quote" id="about-quote">
              “Creo que los grandes espacios se definen por cómo la arquitectura y los materiales se encuentran”
            </blockquote>

            <div class="about-divider">⸻</div>

            <div class="about-disciplines">ARCHITECTURE / INTERIORS / MATERIAL</div>
            <p class="about-presence">Based in Argentina, working across residential, commercial and hospitality projects.</p>

            <div class="about-divider">⸻</div>
          </div>

          <div class="about-meta-grid">
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_studio">ESTUDIO</span>
              <p class="meta-info" id="about-studio-info">JUAN GORENA 1610<br>CONCEPCIÓN, TUCUMÁN<br>ARGENTINA (CP 4146)</p>
            </div>
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_inquiries">CONSULTAS</span>
              <p class="meta-info">
                <a href="mailto:Giovanifrontini@gmail.com" class="editorial-link">GIOVANIFRONTINI@GMAIL.COM</a><br>
                <a href="https://wa.me/5493816382147" target="_blank" rel="noopener" class="editorial-link">+54 9 3816382147</a>
              </p>
            </div>
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_social">REDES</span>
              <p class="meta-info"><a href="https://www.instagram.com/giovannifrontini/" target="_blank" rel="noopener" class="editorial-link" id="about-instagram-link">@GIOVANNIFRONTINI</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Mobile Bottom Sheet Drawer for Project Details -->
  <MobileDrawer />

  <!-- Mobile Menu Fullscreen Blurred Modal (Pacto Estudio Style) -->
  <MobileMenuModal />

  <!-- Contact & WhatsApp Modal -->
  <ContactModal />

  <!-- Fixed Bottom Navigation Bar -->
  <Navbar />
</MainLayout>

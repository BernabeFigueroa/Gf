---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';
import ProjectStrip from '../components/ProjectStrip.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import MobileMenuModal from '../components/MobileMenuModal.astro';
---

<MainLayout>
  <!-- Custom Floating Mouse Follower for Desktop -->
  <div id="custom-cursor" class="custom-cursor">
    <div class="cursor-content">
      <span id="cursor-title" class="cursor-title">CASA PEDREGAL</span>
      <span id="cursor-sub" class="cursor-sub">RESIDENTIAL — 2024</span>
    </div>
  </div>

  <!-- FIXED TOP HEADER -->
  <Header />

  <!-- MAIN GLOBAL VIEW CONTAINER -->
  <main id="app-container" class="app-viewport">

    <!-- VIEW 1: HOME FULL-BLEED SLIDESHOW -->
    <section id="view-home" class="view-panel active">
      <div id="slideshow-track" class="slideshow-track">
        <!-- Slides dynamically rendered by JS -->
      </div>
    </section>

    <!-- VIEW 2: CATEGORY / GRID VIEW (ARQUITECTURA & INTERIORES, ALL PROJECTS) -->
    <section id="view-grid" class="view-panel">
      <div id="projects-grid" class="editorial-grid">
        <!-- Rendered via JS -->
      </div>
    </section>

    <!-- VIEW 2B: MÁRMOL SHOWCASE (Galería curada de marmolería, mesas, mesadas y video de taller) -->
    <section id="view-marmol" class="view-panel">
      <div class="marmol-viewport">
        <header class="marmol-header">
          <span class="mono-label" data-i18n="marmol_badge">[ MARMOLERÍA FRONTINI ]</span>
          <h2 class="marmol-title" data-i18n="marmol_title">MATERIA, PRECISIÓN & CANTERA</h2>
          <p class="marmol-subtitle" data-i18n="marmol_subtitle">Mesas monolíticas, mesadas a medida y transformaciones en piedra natural seleccionada.</p>
        </header>

        <div id="marmol-grid" class="marmol-grid">
          <!-- Rendered via JS dynamically -->
        </div>
      </div>
    </section>

    <!-- VIEW 3: PROJECT DETAIL VIEW -->
    <section id="view-project" class="view-panel">
      <!-- Desktop: Horizontal Multi-Image Carousel | Mobile: Stacked Vertical -->
      <div class="project-view-wrapper">
        <div id="project-gallery-track" class="project-gallery-track">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Desktop Metadata Strip -->
      <ProjectStrip />

      <!-- Mobile Floating CTA: DETAILS -->
      <div class="mobile-cta-wrapper">
        <button id="btn-open-drawer" class="mobile-details-btn" data-action="open-drawer">
          <span id="btn-text-lang" data-i18n="details_btn">DETALLES</span>
        </button>
      </div>
    </section>

    <!-- VIEW 4: ABOUT PAGE -->
    <section id="view-about" class="view-panel">
      <div class="about-container">
        <div class="about-image-column">
          <img id="about-portrait-img" src={`${import.meta.env.BASE_URL}/images/arquitecto/giovanni-frontini.webp`} alt="Giovanni Frontini" class="about-portrait" loading="lazy">
          <div class="portrait-caption mono-label" data-i18n="portrait_caption">GIOVANNI FRONTINI — FUNDADOR Y ARQUITECTO PRINCIPAL</div>
        </div>
        <div class="about-text-column">
          <div class="about-section">
            <h2 class="editorial-heading" id="about-manifesto-title">DISCIPLINA Y SILENCIO</h2>
            <p class="editorial-body" id="about-bio-p1">
              Giovanni Frontini opera en la intersección de la pureza tectónica, la materialidad mineral cruda y la luz coreografiada. El estudio concibe la arquitectura y el diseño de interiores no como una imposición formal, sino como un diálogo riguroso entre la materia noble, el espacio y la luz natural.
            </p>
            <p class="editorial-body" id="about-bio-p2">
              Elaboración, diseño y colocación de piedra natural, mármol, granito, cuarzo y piedra sinterizada. Asesoramiento y presupuesto sin cargo para proyectos residenciales y comerciales.
            </p>
          </div>

          <div class="about-meta-grid">
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_studio">ESTUDIO & TALLER</span>
              <p class="meta-info" id="about-studio-info">JUAN GORENA 1571<br>CONCEPCIÓN, TUCUMÁN<br>ARGENTINA (CP 4146)</p>
            </div>
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_services">ESPECIALIDAD & ASESORAMIENTO</span>
              <p class="meta-info" id="about-services-info">PIEDRA NATURAL, MÁRMOL, GRANITO, CUARZO & PIEDRA SINTERIZADA.<br>ASESORAMIENTO Y PRESUPUESTO SIN CARGO.</p>
            </div>
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_inquiries">CONSULTAS</span>
              <p class="meta-info"><a href="mailto:studio@giovannifrontini.com" class="editorial-link">STUDIO@GIOVANNIFRONTINI.COM</a><br>+54 9 3865 000000</p>
            </div>
            <div class="meta-block">
              <span class="mono-label" data-i18n="label_social">REDES</span>
              <p class="meta-info"><a href="https://www.instagram.com/marmoleriafrontini/" target="_blank" rel="noopener" class="editorial-link" id="about-instagram-link">@MARMOLERIAFRONTINI</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Mobile Bottom Sheet Drawer for Project Details -->
  <MobileDrawer />

  <!-- Mobile Menu Fullscreen Blurred Modal (Pacto Estudio Style) -->
  <MobileMenuModal />

  <!-- Fixed Bottom Navigation Bar -->
  <Navbar />
</MainLayout>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "GIOVANNI FRONTINI — Architecture & Spatial Design", 
  description = "Editorial architecture and spatial design portfolio for Giovanni Frontini. Residential, retail, and cultural architecture." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Fallback & Micro-copy Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-light text-primary select-none antialiased">
  <slot />
  <script src={`${import.meta.env.BASE_URL}/script.js`} is:inline></script>
</body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "GIOVANNI FRONTINI — Architecture & Spatial Design", 
  description = "Editorial architecture and spatial design portfolio for Giovanni Frontini. Residential, retail, and cultural architecture." 
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#2d1615">

  <!-- Immediate Theme & Palette Initialization to prevent Safari bar color flash -->
  <script is:inline>
    (function() {
      try {
        var p = localStorage.getItem('gf_portfolio_palette');
        if (p === 'invert') {
          document.documentElement.setAttribute('data-palette', 'invert');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#000000');
        }
      } catch(e) {}
    })();
  </script>

  <!-- Preload Custom Editorial Font -->
  <link rel="preload" href={`${base}/font/Patinio Basica.ttf`} as="font" type="font/ttf" crossorigin>

  <!-- Fallback & Micro-copy Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-light text-primary select-none antialiased">
  <slot />
  <script src={`${base}/script.js`} is:inline></script>
</body>
</html>

---
// Navbar.astro - Barra inferior fija: en desktop tabs horizontales, en mobile correo izquierda + hamburguesa derecha
---
<nav class="fixed-bottom-nav">
  <!-- Desktop Navigation Tabs (Oculto en móvil) -->
  <div class="nav-left desktop-only">
    <button class="nav-tab active" data-target="home" data-action="nav-home" data-i18n="nav_home">INICIO</button>
    <button class="nav-tab" data-target="arquitectura" data-action="filter-arquitectura" data-i18n="nav_arquitectura">ARQUITECTURA & INTERIORES</button>
    <button class="nav-tab" data-target="marmol" data-action="filter-marmol" data-i18n="nav_marmol">MÁRMOL</button>
  </div>

  <div class="nav-right desktop-only">
    <button class="nav-tab" data-target="projects" data-action="filter-all" data-i18n="nav_projects">PROYECTOS</button>
    <button class="nav-tab" data-target="about" data-action="nav-about" data-i18n="nav_about">SOBRE MÍ</button>
    <a href="https://www.instagram.com/marmoleriafrontini/" target="_blank" rel="noopener" class="nav-icon-link" aria-label="Instagram">
      <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
    </a>
    <a href="mailto:studio@giovannifrontini.com" class="nav-icon-link" aria-label="Email">
      <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    </a>
    <button id="lang-toggle-btn" class="nav-tab-square lang-box" data-action="toggle-lang">ES</button>
    <button class="nav-theme-dot" data-action="toggle-theme" aria-label="Cambiar paleta de colores" title="Cambiar paleta de colores"></button>
  </div>

  <!-- Mobile Bottom Bar: Botón de Correo a la izquierda y Botón Hamburguesa a la derecha -->
  <div class="mobile-bottom-bar mobile-only">
    <a href="mailto:studio@giovannifrontini.com" class="mobile-nav-btn mail-icon-btn" aria-label="Email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mobile-bottom-svg">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    </a>

    <button class="mobile-nav-btn hamburger-btn" data-action="open-mobile-menu" aria-label="Abrir menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mobile-bottom-svg">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</nav>

---
// ContactModal.astro - Modal de contacto directo para proyectos / WhatsApp
---
<div id="contact-modal" class="contact-modal" aria-hidden="true">
  <div class="contact-modal-backdrop" data-action="close-contact-modal"></div>
  
  <div class="contact-modal-window" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <div class="contact-modal-header">
      <div class="contact-modal-tag" data-i18n="contact_modal_tag">[ INICIAR PROYECTO ]</div>
      <button class="contact-close-btn" data-action="close-contact-modal" aria-label="Cerrar modal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact-close-svg">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="contact-modal-body">
      <h3 id="contact-modal-title" class="contact-title" data-i18n="contact_modal_title">HABLEMOS DE TU PROYECTO</h3>
      <p class="contact-subtitle" data-i18n="contact_modal_subtitle">
        Completá tus datos para enviarnos tu consulta directamente a WhatsApp.
      </p>

      <form id="contact-wsp-form" class="contact-form" autocomplete="off">
        <div class="contact-form-row">
          <div class="contact-field-group">
            <label for="contact-nombre" class="contact-label" data-i18n="contact_label_name">NOMBRE *</label>
            <input 
              type="text" 
              id="contact-nombre" 
              name="nombre" 
              class="contact-input" 
              placeholder="Ej. Juan" 
              required 
            />
          </div>

          <div class="contact-field-group">
            <label for="contact-apellido" class="contact-label" data-i18n="contact_label_lastname">APELLIDO *</label>
            <input 
              type="text" 
              id="contact-apellido" 
              name="apellido" 
              class="contact-input" 
              placeholder="Ej. Pérez" 
              required 
            />
          </div>
        </div>

        <div class="contact-field-group">
          <label for="contact-numero" class="contact-label" data-i18n="contact_label_phone">NÚMERO DE TELÉFONO</label>
          <input 
            type="tel" 
            id="contact-numero" 
            name="numero" 
            class="contact-input" 
            placeholder="Ej. +54 9 381 000000" 
          />
        </div>

        <div class="contact-field-group">
          <label for="contact-mensaje" class="contact-label" data-i18n="contact_label_message">¿QUÉ TENÉS EN MENTE? *</label>
          <textarea 
            id="contact-mensaje" 
            name="mensaje" 
            rows="4" 
            class="contact-textarea" 
            placeholder="Contanos sobre tu idea, proyecto o espacio a transformar..." 
            required
          ></textarea>
        </div>

        <button type="submit" class="contact-submit-btn">
          <span class="contact-btn-text" data-i18n="contact_btn_send">ENVIAR A WHATSAPP</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="contact-btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>
